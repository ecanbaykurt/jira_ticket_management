# Optional fallback if you prefer .env instead of in-app Settings.
# Prefer: open the app → Settings → save (writes .jane-secrets.json, gitignored).

# --- Jira Cloud ---
JIRA_BASE_URL=https://YOUR_ORG.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_JQL=project = BI ORDER BY created DESC
JIRA_MAX_RESULTS=200
JIRA_FIELD_STORY_POINTS=
JIRA_FIELD_SPRINT=
JIRA_FIELD_TEAM=
JIRA_WRITE_COMMENTS=false

# --- Google Sheets (optional second datasource) ---
# Create an API key in Google Cloud with Sheets API enabled.
# Share the sheet with "anyone with link can view" OR restrict by key restrictions.
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SHEETS_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_RANGE=Tickets!A:P

# --- Schedule ---
JANE_TZ=America/New_York
